# Senha do painel /admin (obrigatória para o painel funcionar)
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar os cookies (qualquer texto longo e aleatório)
SESSION_SECRET=troque-este-segredo-por-algo-aleatorio

# Chave da Claude API (console.anthropic.com). Ativa a IA que liga cada oferta
# ao item certo e sugere para quem repassar as doações já recebidas.
# Sem ela o site funciona normalmente, só sem as sugestões.
ANTHROPIC_API_KEY=

# Modelo usado pela IA (opcional)
# IA_MODELO=claude-opus-5-5

# Quanto tempo (ms) o doador espera pela análise da IA antes de ver a página de obrigado (opcional)
# IA_TEMPO_LIMITE_MS=15000

# Porta do servidor (opcional, padrão 3000; o Railway define sozinho)
PORT=3000

# Caminho do arquivo SQLite (opcional, padrão ./data/corrente.db)
# No Railway, aponte para dentro do volume: /data/corrente.db
# DATABASE_PATH=/data/corrente.db
