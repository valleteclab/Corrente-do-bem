<% if (iaAtiva) { %>
  <div class="barra-ia">
    <span>🤖 <strong>IA de repasse</strong>: lê cada oferta, liga ao item certo da lista e sugere para quem repassar.
      <% if (pendentesIa > 0) { %><%= pendentesIa %> oferta(s) ainda sem análise.<% } else { %>Todas as ofertas em andamento já foram analisadas.<% } %>
    </span>
    <span class="barra-ia-acoes">
      <% if (pendentesIa > 0) { %>
        <form method="post" action="/admin/corrente/ia/analisar" class="inline">
          <input type="hidden" name="voltar" value="<%= voltar %>">
          <button class="btn btn-pequeno btn-ia">Analisar pendentes</button>
        </form>
      <% } %>
      <form method="post" action="/admin/corrente/ia/analisar" class="inline">
        <input type="hidden" name="todas" value="1"><input type="hidden" name="voltar" value="<%= voltar %>">
        <button class="btn btn-pequeno btn-secundario">Reanalisar todas</button>
      </form>
    </span>
  </div>
<% } else { %>
  <div class="aviso aviso-info">🤖 As sugestões de repasse por IA estão desativadas. Defina a variável <code>ANTHROPIC_API_KEY</code> no servidor para ativar.</div>
<% } %>
