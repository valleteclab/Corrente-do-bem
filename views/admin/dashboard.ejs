<%- include('../partials/head') %>

<h1>Moderação</h1>

<section class="numeros">
  <a href="/admin/verificacoes" class="numero numero-alerta"><strong><%= statsRede.aguardando %></strong><span>verificações na fila</span></a>
  <a href="/admin/denuncias" class="numero <%= denuncias ? 'numero-alerta' : '' %>"><strong><%= denuncias %></strong><span>denúncias abertas</span></a>
  <a href="/admin/usuarios?status=verificado" class="numero"><strong><%= statsRede.verificados %></strong><span>membros verificados</span></a>
  <a href="/admin/usuarios" class="numero"><strong><%= statsRede.total %></strong><span>contas no total</span></a>
</section>

<section>
  <h2>Próximas verificações</h2>
  <% if (verificacoes.length === 0) { %>
    <p class="vazio">Fila vazia. 👌</p>
  <% } else { %>
    <ul class="lista-simples">
      <% for (const v of verificacoes) { %>
        <li><strong><%= v.nome %></strong> (<%= rotulos.tipoUsuario[v.tipo] %><%= v.cidade ? ', ' + v.cidade : '' %>)
          <% if (v.convidante_nome) { %><span class="badge badge-verificado">convite de <%= v.convidante_nome %></span><% } %>
          <% if (v.recomendacao_ia) { %><span class="badge badge-ia">IA: <%= v.recomendacao_ia %></span><% } %>
          · <%= formatarData(v.criado_em) %></li>
      <% } %>
    </ul>
    <p><a href="/admin/verificacoes" class="btn btn-pequeno">Analisar fila →</a></p>
  <% } %>
</section>

<section>
  <h2><%= config.nome_campanha %></h2>
  <div class="numeros">
    <a href="/admin/corrente/ofertas?status=nova" class="numero"><strong><%= stats.ofertas_novas %></strong><span>ofertas novas</span></a>
    <a href="/admin/corrente/ofertas?status=disponivel" class="numero"><strong><%= stats.ofertas_disponiveis %></strong><span>doações para repassar</span></a>
    <a href="/admin/corrente/pedidos?status=aberto" class="numero"><strong><%= stats.pedidos_abertos %></strong><span>pedidos esperando</span></a>
    <a href="/admin/corrente/necessidades" class="numero"><strong><%= stats.necessidades_abertas %></strong><span>itens que ela ainda precisa</span></a>
  </div>
  <%- include('../partials/barra-ia', { pendentesIa, voltar: '/admin' }) %>
</section>

<%- include('../partials/foot') %>
