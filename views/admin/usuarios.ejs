<%- include('../partials/head') %>

<h1>Membros</h1>

<form method="get" action="/admin/usuarios" class="filtro filtro-grade">
  <input type="text" name="q" placeholder="Buscar por nome" value="<%= filtro.busca %>" maxlength="120">
  <select name="tipo">
    <option value="">Pessoas e empresas</option>
    <option value="pessoa" <%= filtro.tipo === 'pessoa' ? 'selected' : '' %>>Pessoas</option>
    <option value="empresa" <%= filtro.tipo === 'empresa' ? 'selected' : '' %>>Empresas</option>
  </select>
  <select name="status">
    <option value="">Qualquer status</option>
    <% for (const s of statusLista) { %><option value="<%= s %>" <%= filtro.status === s ? 'selected' : '' %>><%= rotulos.verificacao[s] %></option><% } %>
  </select>
  <button class="btn btn-pequeno">Filtrar</button>
</form>

<% if (usuarios.length === 0) { %>
  <p class="vazio">Ninguém encontrado.</p>
<% } else { %>
<ul class="lista-admin">
  <% for (const u of usuarios) { %>
    <li class="item-admin <%= u.banido ? 'status-cancelada' : '' %>">
      <div class="item-cab">
        <%- include('../partials/avatar', { pessoa: u, tamanho: 'avatar-mini' }) %>
        <a href="/u/<%= u.id %>" target="_blank"><strong><%= u.nome %></strong></a>
        <span class="tag"><%= rotulos.tipoUsuario[u.tipo] %></span>
        <span class="badge badge-<%= u.status_verificacao %>"><%= rotulos.verificacao[u.status_verificacao] %></span>
        <% if (u.papel === 'moderador') { %><span class="badge badge-ia">moderador</span><% } %>
        <% if (u.banido) { %><span class="badge badge-cancelada">suspensa</span><% } %>
        <span class="muted mini">#<%= u.id %> · <%= formatarData(u.criado_em) %></span>
      </div>
      <p class="mini muted"><%= u.email %><%= u.whatsapp ? ' · ' + u.whatsapp : '' %><%= u.cidade ? ' · ' + u.cidade : '' %><%= u.estado ? '/' + u.estado : '' %><%= u.categoria ? ' · ' + u.categoria : '' %> · convites: <%= u.convites_restantes %></p>
      <div class="item-acoes">
        <% if (u.status_verificacao !== 'verificado') { %>
          <form method="post" action="/admin/usuarios/<%= u.id %>/status" class="inline"><input type="hidden" name="status" value="verificado"><input type="hidden" name="voltar" value="<%= caminho %>"><button class="btn btn-pequeno btn-ok">Verificar manualmente</button></form>
        <% } else { %>
          <form method="post" action="/admin/usuarios/<%= u.id %>/status" class="inline"><input type="hidden" name="status" value="pendente"><input type="hidden" name="voltar" value="<%= caminho %>"><button class="btn btn-pequeno btn-secundario">Tirar selo</button></form>
        <% } %>
        <form method="post" action="/admin/usuarios/<%= u.id %>/convites" class="inline"><input type="hidden" name="quantidade" value="5"><input type="hidden" name="voltar" value="<%= caminho %>"><button class="btn btn-pequeno btn-secundario">+5 convites</button></form>
        <form method="post" action="/admin/usuarios/<%= u.id %>/papel" class="inline"><input type="hidden" name="papel" value="<%= u.papel === 'moderador' ? 'membro' : 'moderador' %>"><input type="hidden" name="voltar" value="<%= caminho %>"><button class="btn btn-pequeno btn-secundario"><%= u.papel === 'moderador' ? 'Remover moderador' : 'Tornar moderador' %></button></form>
        <form method="post" action="/admin/usuarios/<%= u.id %>/banir" class="inline" onsubmit="return confirm('<%= u.banido ? 'Reativar' : 'Suspender' %> esta conta?')"><input type="hidden" name="banido" value="<%= u.banido ? '0' : '1' %>"><input type="hidden" name="voltar" value="<%= caminho %>"><button class="btn btn-pequeno btn-perigo"><%= u.banido ? 'Reativar' : 'Suspender' %></button></form>
      </div>
    </li>
  <% } %>
</ul>
<% } %>

<%- include('../partials/foot') %>
