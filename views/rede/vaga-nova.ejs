<%- include('../partials/head') %>

<h1>Publicar vaga</h1>
<% if (erros.length) { %>
  <div class="aviso aviso-erro"><ul><% for (const e of erros) { %><li><%= e %></li><% } %></ul></div>
<% } %>
<form method="post" action="/vagas/nova" class="form">
  <label>Título
    <input type="text" name="titulo" required maxlength="120" value="<%= valores.titulo || '' %>" placeholder="Ex.: Atendente de loja, Pedreiro, Desenvolvedor...">
  </label>
  <div class="linha-2">
    <label>Tipo
      <select name="tipo"><% for (const t of tiposVaga) { %><option value="<%= t %>" <%= valores.tipo === t ? 'selected' : '' %>><%= t %></option><% } %></select>
    </label>
    <label>Cidade
      <input type="text" name="cidade" maxlength="120" value="<%= valores.cidade || '' %>">
    </label>
  </div>
  <label>Descrição
    <textarea name="descricao" rows="8" maxlength="3000" required placeholder="O que a pessoa vai fazer, requisitos, horário, salário ou faixa, como será a seleção..."><%= valores.descricao || '' %></textarea>
  </label>
  <p class="mini muted">A vaga fica aberta a todos os membros verificados. Lembre-se de seguir a legislação trabalhista.</p>
  <button class="btn btn-grande">Publicar</button>
</form>

<%- include('../partials/foot') %>
