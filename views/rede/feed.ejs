<%- include('../partials/head') %>

<div class="duas-colunas">
<section class="coluna-principal">
  <nav class="abas abas-feed">
    <a href="/feed" class="ativo">📰 Feed</a>
    <a href="/reels">🎬 Reels</a>
  </nav>

  <% if (usuario.status_verificacao === 'verificado') { %>
    <form method="post" action="/post" enctype="multipart/form-data" class="form form-post" id="form-post">
      <div class="post-cab">
        <%- include('../partials/avatar', { pessoa: usuario, tamanho: 'avatar-mini' }) %>
        <textarea name="texto" rows="2" maxlength="2000" placeholder="Compartilhe algo com a comunidade de <%= usuario.cidade || 'sua cidade' %>..."></textarea>
      </div>
      <div class="post-ferramentas">
        <label class="btn btn-pequeno btn-secundario">📷 Fotos (até 4)
          <input type="file" name="midias" accept="image/jpeg,image/png,image/webp" multiple hidden onchange="document.getElementById('previa').textContent = this.files.length + ' foto(s) selecionada(s)'; document.getElementById('video-input').value=''">
        </label>
        <label class="btn btn-pequeno btn-secundario">🎬 Vídeo (reel)
          <input type="file" name="midias" id="video-input" accept="video/mp4,video/webm,video/quicktime" hidden onchange="document.getElementById('previa').textContent = this.files.length ? 'vídeo: ' + this.files[0].name : ''">
        </label>
        <span id="previa" class="mini muted"></span>
        <button class="btn btn-pequeno">Publicar</button>
      </div>
    </form>
  <% } else { %>
    <div class="aviso aviso-info">Para publicar, curtir e comentar, <a href="/verificacao">pegue seu selo <%= config.nome_selo %></a>.</div>
  <% } %>

  <form method="get" action="/feed" class="filtro filtro-linha">
    <input type="text" name="cidade" placeholder="Filtrar por cidade" value="<%= cidadeFiltro %>" maxlength="120">
    <button class="btn btn-pequeno btn-secundario">Filtrar</button>
    <% if (cidadeFiltro) { %><a href="/feed" class="mini">limpar</a><% } %>
  </form>

  <% if (posts.length === 0) { %>
    <p class="vazio">Nenhuma publicação ainda. Seja o primeiro!</p>
  <% } else { %>
    <ul class="posts">
      <% for (const p of posts) { %><%- include('../partials/post', { p, voltar: caminho, compacto: false }) %><% } %>
    </ul>
  <% } %>
</section>

<aside class="coluna-lateral">
  <div class="caixa">
    <h3><%= meu.nivel.icone %> Nível <%= meu.nivel.nome %></h3>
    <p><strong><%= meu.pontos %></strong> pontos<% if (meu.nivel.proximo) { %> · faltam <%= meu.nivel.faltam %> para <%= meu.nivel.proximo.nome %><% } %></p>
    <% if (pendentes) { %><p class="aviso aviso-atencao aviso-fino">🔗 <strong><%= pendentes %></strong> negócio(s) para confirmar. <a href="/negocios">Confirmar</a></p><% } %>
    <p><a href="/negocios">Meus pontos e negócios</a> · <a href="/ranking">Ranking</a></p>
  </div>
  <div class="caixa">
    <h3>Atalhos</h3>
    <p>
      <a href="/vagas/nova">+ Publicar vaga</a><br>
      <a href="/curriculo">📄 Meu currículo</a><br>
      <a href="/talentos">🧑‍💼 Talentos (quem procura trabalho)</a><br>
      <a href="/diretorio">🏪 Diretório</a><br>
      <a href="/convites">🎟️ Meus convites</a><br>
      <a href="/corrente">💛 <%= config.nome_campanha %></a> · <a href="/corrente/minha">minha</a>
    </p>
  </div>
  <div class="caixa">
    <h3>A rede hoje</h3>
    <p><strong><%= stats.verificados %></strong> membros com selo<br><strong><%= stats.empresas %></strong> empresas<br><strong><%= stats.cidades %></strong> cidades</p>
  </div>
</aside>
</div>

<%- include('../partials/foot') %>
